From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yellow Stick <dev@yellow-stick.local>
Date: Sun, 8 Nov 2026 22:00:00 +0100
Subject: [PATCH] gobject: gsourceclosure: do not reference g_io_watch_funcs on wasm

giounix.c is not built for Emscripten, so g_io_watch_funcs is never defined
there and every binary pulling gsourceclosure.c (g_source_set_closure) fails
to link with "undefined symbol: g_io_watch_funcs". No GIOChannel watch can
exist on wasm, so skip the comparisons like the Unix fd/signal sources
already are.
---
 gobject/gsourceclosure.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/gobject/gsourceclosure.c b/gobject/gsourceclosure.c
--- a/gobject/gsourceclosure.c
+++ b/gobject/gsourceclosure.c
@@ -78,6 +78,7 @@
   g_value_set_boolean (return_value, v_return);
 }
 
+#ifndef G_PLATFORM_WASM
 static gboolean
 io_watch_closure_callback (GIOChannel   *channel,
 			   GIOCondition  condition,
@@ -105,6 +106,7 @@
 
   return result;
 }
+#endif
 
 static gboolean
 g_child_watch_closure_callback (GPid     pid,
@@ -199,9 +201,12 @@
 
   if (!closure_callback)
     {
+#ifndef G_PLATFORM_WASM
       if (source->source_funcs == &g_io_watch_funcs)
         closure_callback = (GSourceFunc)io_watch_closure_callback;
-      else if (source->source_funcs == &g_child_watch_funcs)
+      else
+#endif
+      if (source->source_funcs == &g_child_watch_funcs)
         closure_callback = (GSourceFunc)g_child_watch_closure_callback;
 #if defined(G_OS_UNIX) && !defined(G_PLATFORM_WASM)
       else if (source->source_funcs == &g_unix_fd_source_funcs)
@@ -256,7 +261,9 @@
       source->source_funcs != &g_unix_signal_funcs &&
 #endif
       source->source_funcs != &g_child_watch_funcs &&
+#ifndef G_PLATFORM_WASM
       source->source_funcs != &g_io_watch_funcs &&
+#endif
       source->source_funcs != &g_timeout_funcs &&
       source->source_funcs != &g_idle_funcs)
     {
-- 
2.43.0

