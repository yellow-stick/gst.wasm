From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yellow Stick <dev@yellow-stick.local>
Date: Mon, 9 Nov 2026 01:00:00 +0100
Subject: [PATCH] glib: free_full: call the GDestroyNotify without a GFunc cast

g_list_free_full (), g_slist_free_full (), g_queue_free_full () and
g_queue_clear_full () called free_func through g_*_foreach () as a GFunc,
which takes one more argument: undefined behaviour. With
-fwasm-fix-function-bitcasts each such cast goes through runtime wrappers
whose target is kept in shared memory slots; when two threads free lists
at the same time a free function can run on the other thread's elements.
Seen in GStreamer as GstVideoDecoder freeing its frames with another
element's destroy function, then heap corruption. Call free_func directly.
---
 3 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/glib/glist.c b/glib/glist.c
--- a/glib/glist.c
+++ b/glib/glist.c
@@ -243,7 +243,11 @@
 g_list_free_full (GList          *list,
                   GDestroyNotify  free_func)
 {
-  g_list_foreach (list, (GFunc) free_func, NULL);
+  GList *l;
+
+  /* No GDestroyNotify to GFunc cast: see the commit message */
+  for (l = list; l; l = l->next)
+    free_func (l->data);
   g_list_free (list);
 }
 
diff --git a/glib/gslist.c b/glib/gslist.c
--- a/glib/gslist.c
+++ b/glib/gslist.c
@@ -197,7 +197,11 @@
 g_slist_free_full (GSList         *list,
 		   GDestroyNotify  free_func)
 {
-  g_slist_foreach (list, (GFunc) free_func, NULL);
+  GSList *l;
+
+  /* No GDestroyNotify to GFunc cast: see the commit message */
+  for (l = list; l; l = l->next)
+    free_func (l->data);
   g_slist_free (list);
 }
 
diff --git a/glib/gqueue.c b/glib/gqueue.c
--- a/glib/gqueue.c
+++ b/glib/gqueue.c
@@ -110,7 +110,11 @@
 g_queue_free_full (GQueue        *queue,
                   GDestroyNotify  free_func)
 {
-  g_queue_foreach (queue, (GFunc) free_func, NULL);
+  GList *l;
+
+  /* No GDestroyNotify to GFunc cast: see the commit message */
+  for (l = queue->head; l; l = l->next)
+    free_func (l->data);
   g_queue_free (queue);
 }
 
@@ -169,7 +173,12 @@
   g_return_if_fail (queue != NULL);
 
   if (free_func != NULL)
-    g_queue_foreach (queue, (GFunc) free_func, NULL);
+    {
+      GList *l;
+
+      for (l = queue->head; l; l = l->next)
+        free_func (l->data);
+    }
 
   g_queue_clear (queue);
 }
