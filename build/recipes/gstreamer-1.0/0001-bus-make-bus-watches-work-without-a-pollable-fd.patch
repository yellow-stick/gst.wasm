From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yellow Stick <dev@yellow-stick.local>
Date: Sun, 8 Nov 2026 23:20:00 +0100
Subject: [PATCH] bus: make bus watches work without a pollable fd

The wasm port removed the GstPoll of the bus (its socketpair can not be
polled under Emscripten) and left the bus GSource with no prepare () and a
check () that always returns FALSE: gst_bus_add_watch () and signal
watches never dispatch. Everything built on them stalls, e.g.
GstDiscoverer in async mode only ends with its timeout, so GES can not
load any project.

Make the source ready whenever messages are pending and wake up its
GMainContext when a message is queued.

Once dispatched, the GstBusFunc stored as a GSourceFunc was called through
a wrapper generated by -fwasm-fix-function-bitcasts for the direct
function pointer cast, with the GSourceFunc signature: "function signature
mismatch". Cast through a data pointer instead.
---
 subprojects/gstreamer/gst/gstbus.c | 42 +++++++++++++++++++++++++++++++++++++++---
 1 file changed, 39 insertions(+), 3 deletions(-)

diff --git a/subprojects/gstreamer/gst/gstbus.c b/subprojects/gstreamer/gst/gstbus.c
--- a/subprojects/gstreamer/gst/gstbus.c
+++ b/subprojects/gstreamer/gst/gstbus.c
@@ -308,6 +308,26 @@
  *
  * Returns: %TRUE if the message could be posted, %FALSE if the bus is flushing.
  */
+/* The bus has no pollable fd here: wake up the main context the bus watch is
+ * attached to, so that its prepare () sees the pending message */
+static void
+gst_bus_wakeup_watch (GstBus * bus)
+{
+  GMainContext *ctx = NULL;
+
+  GST_OBJECT_LOCK (bus);
+  if (bus->priv->gsource && !g_source_is_destroyed (bus->priv->gsource))
+    ctx = g_source_get_context (bus->priv->gsource);
+  if (ctx)
+    g_main_context_ref (ctx);
+  GST_OBJECT_UNLOCK (bus);
+
+  if (ctx) {
+    g_main_context_wakeup (ctx);
+    g_main_context_unref (ctx);
+  }
+}
+
 gboolean
 gst_bus_post (GstBus * bus, GstMessage * message)
 {
@@ -378,6 +398,7 @@
       g_cond_signal (&bus->priv->cond);
       GST_DEBUG_OBJECT (bus, "[msg %p] pushed on async queue", message);
       g_mutex_unlock (&bus->priv->queue_lock);
+      gst_bus_wakeup_watch (bus);
 
       break;
     }
@@ -404,6 +425,7 @@
       gst_vec_deque_push_tail (bus->priv->queue, message);
       g_cond_signal (&bus->priv->cond);
       g_mutex_unlock (&bus->priv->queue_lock);
+      gst_bus_wakeup_watch (bus);
 
       /* now block till the message is freed */
       g_cond_wait (cond, lock);
@@ -790,19 +812,33 @@
   GstBus *bus;
 } GstBusSource;
 
+/* Without a pollable fd, the source is ready whenever messages are queued;
+ * gst_bus_post () wakes up the context */
+static gboolean
+gst_bus_source_prepare (GSource * source, gint * timeout)
+{
+  GstBusSource *bsrc = (GstBusSource *) source;
+
+  *timeout = -1;
+  return gst_bus_have_pending (bsrc->bus);
+}
+
 static gboolean
 gst_bus_source_check (GSource * source)
 {
   GstBusSource *bsrc = (GstBusSource *) source;
 
-  return FALSE; /* bsrc->bus->priv->pollfd.revents & (G_IO_IN | G_IO_HUP | G_IO_ERR); */
+  return gst_bus_have_pending (bsrc->bus);
 }
 
 static gboolean
 gst_bus_source_dispatch (GSource * source, GSourceFunc callback,
     gpointer user_data)
 {
-  GstBusFunc handler = (GstBusFunc) callback;
+  /* callback is a GstBusFunc stored as a GSourceFunc. Cast through a data
+   * pointer: a direct function pointer cast makes -fwasm-fix-function-bitcasts
+   * call it through a GSourceFunc wrapper, which traps on wasm */
+  GstBusFunc handler = (GstBusFunc) (gpointer) callback;
   GstBusSource *bsource = (GstBusSource *) source;
   GstMessage *message;
   gboolean keep;
@@ -868,7 +904,7 @@
 }
 
 static GSourceFuncs gst_bus_source_funcs = {
-  NULL,
+  gst_bus_source_prepare,
   gst_bus_source_check,
   gst_bus_source_dispatch,
   gst_bus_source_finalize
-- 
2.43.0

