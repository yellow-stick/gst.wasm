<ges version='0.7'>
  <project properties='properties;' metadatas='metadatas, name=(string)ys-two-clips-crossfade;'>
    <encoding-profiles>
    </encoding-profiles>
    <ressources>
      <asset id='file:///media/clip-a.mp4' extractable-type-name='GESUriClip' properties='properties, supported-formats=(int)4;' metadatas='metadatas;'/>
      <asset id='file:///media/clip-b.mp4' extractable-type-name='GESUriClip' properties='properties, supported-formats=(int)4;' metadatas='metadatas;'/>
    </ressources>
    <!--
      30 fps timeline, times are floor(frame * 1e9 / 30) ns:
        clip-a: start 0 (frame 0), inpoint 333333333 (source frame 10),
                duration 2000000000 (60 frames)  -> timeline frames [0, 60)
        clip-b: start 1500000000 (frame 45), inpoint 666666666 (source frame 20),
                duration 2000000000 (60 frames)  -> timeline frames [45, 105)
      The 15 frame overlap [45, 60) gets an automatic crossfade.
    -->
    <timeline properties='properties, auto-transition=(boolean)true, snapping-distance=(guint64)0;' metadatas='metadatas, duration=(guint64)3500000000;'>
      <track caps='video/x-raw(ANY)' track-type='4' track-id='0' properties='properties, restriction-caps=(string)&quot;video/x-raw\,\ width\=\(int\)320\,\ height\=\(int\)240\,\ framerate\=\(fraction\)30/1&quot;, mixing=(boolean)true;' metadatas='metadatas;'/>
      <layer priority='0' properties='properties, auto-transition=(boolean)true;' metadatas='metadatas;'>
        <clip id='0' asset-id='file:///media/clip-a.mp4' type-name='GESUriClip' layer-priority='0' track-types='4' start='0' duration='2000000000' inpoint='333333333' rate='0' properties='properties, name=(string)clip-a, mute=(boolean)false, is-image=(boolean)false;' metadatas='metadatas;'>
        </clip>
        <clip id='1' asset-id='file:///media/clip-b.mp4' type-name='GESUriClip' layer-priority='0' track-types='4' start='1500000000' duration='2000000000' inpoint='666666666' rate='0' properties='properties, name=(string)clip-b, mute=(boolean)false, is-image=(boolean)false;' metadatas='metadatas;'>
        </clip>
      </layer>
    </timeline>
  </project>
</ges>
